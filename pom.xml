<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- MuleShift S3 scaffold. Structure is governed by docs/adr/ADR-0001 and ADR-0044. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.westfield.api</groupId>
  <artifactId>sys-billing-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>sys-billing</name>
  <description>Migration target for MuleSoft sapi-billing. One deployable, three owned modules.</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.3.0</archunit.version>
    <wiremock.version>3.9.1</wiremock.version>
    <testcontainers.version>1.20.4</testcontainers.version>
  </properties>

  <modules>
    <module>platform/platform-bom</module>
    <module>platform/platform-spi</module>
    <module>platform/platform-observability</module>
    <module>platform/platform-errors</module>
    <module>platform/platform-testing</module>
    <module>services/billing-account</module>
    <module>services/billing-agency</module>
    <module>services/billing-edge</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.westfield.api</groupId>
        <artifactId>platform-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
