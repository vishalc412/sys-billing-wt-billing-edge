<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local, credential-free Maven settings for building sys-billing in this environment.

  The machine's global ~/.m2/settings.xml points "central" at an internal Artifactory
  mirror (myartifactory.mypepsico.com) which returned 401 Unauthorized when tested here,
  and is unrelated to this project. This file overrides "central" back to Maven Central
  so the build can resolve public dependencies without touching the user's global config.

  Usage: ./mvnw -s .mvn/settings-build.xml clean test package
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd">
    <profiles>
        <profile>
            <id>central</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <name>Maven Central</name>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>central</id>
                    <name>Maven Central</name>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>central</activeProfile>
    </activeProfiles>
</settings>
