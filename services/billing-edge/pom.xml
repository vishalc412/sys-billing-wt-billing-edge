<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.westfield.api</groupId>
    <artifactId>sys-billing-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>billing-edge</artifactId>
  <name>billing-edge</name>

  <dependencies>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>billing-account</artifactId>
    </dependency>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>billing-agency</artifactId>
    </dependency>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>platform-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>platform-errors</artifactId>
    </dependency>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>platform-observability</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>platform-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      The packet's dependency_contracts require the PingFederate STS and Thycotic Secret Server to be
      stubbed with WireMock rather than waited on. The version is managed by platform-bom, so nothing
      new is introduced to the dependency surface.
    -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.westfield.api.billing.edge.SysBillingApplication</mainClass>
        </configuration>
        <executions>
          <execution><goals><goal>repackage</goal></goals></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
