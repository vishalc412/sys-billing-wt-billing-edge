<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.westfield.api</groupId>
    <artifactId>sys-billing-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>billing-edge</artifactId>
  <name>billing-edge</name>

  <dependencies>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>billing-account</artifactId>
    </dependency>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>billing-agency</artifactId>
    </dependency>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>platform-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>platform-errors</artifactId>
    </dependency>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>platform-observability</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.westfield.api</groupId>
      <artifactId>platform-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      The packet's dependency_contracts require the PingFederate STS and Thycotic Secret Server to be
      stubbed with WireMock rather than waited on. The version is managed by platform-bom, so nothing
      new is introduced to the dependency surface.
    -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.westfield.api.billing.edge.SysBillingApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <id>generate-build-info</id>
            <!--
              DEF-0109 (ADR-0018, INF-001-a/c): generate META-INF/build-info.properties so
              BuildProperties is auto-configured and /info reports real build provenance instead of
              the legacy '0' buildNumber and textual placeholder defaults. The legacy ships a
              checked-in buildInfo.properties carrying unsubstituted @pomBuildNumber@ tokens that
              resolve to their own text; the generated file cannot, and the enforcer + startup check
              below make that a hard failure.
            -->
            <phase>generate-resources</phase>
            <goals>
              <goal>build-info</goal>
            </goals>
            <configuration>
              <additionalProperties>
                <!-- BuildProperties has no standard "number" key; expose the build timestamp as the
                  build number so /info's buildNumber is real and not the '0' default. -->
                <number>${maven.build.timestamp}</number>
              </additionalProperties>
            </configuration>
          </execution>
          <execution><id>repackage</id><goals><goal>repackage</goal></goals></execution>
        </executions>
      </plugin>
      <!--
        DEF-0109 (INF-001-c): a build-time guard complementing BuildMetadataAdapter's startup
        validateNoUnsubstitutedTokens. requireMavenVersion/requireJavaVersion fail the build when the
        toolchain does not match the supported one; the generated build-info.properties (not a
        checked-in file) cannot carry an unsubstituted @…@/${…} token, so a legacy-style unfiltered
        build cannot recur silently.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-provenance</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
