#%RAML 1.0 DataType
type: object
properties: 
  faultActor: 
    type: string
    example: tos-ingeniux-sys-api
  faultCode: 
    type: string
    example: METHOD_NOT_ALLOWED
  faultMessage: 
    type: string
    example: "/pageCommand/pageVersion/{pageId}/{versionId} : post"
  faultDetail: 
    type: string
    example: "/pageCommand/pageVersion/{pageId}/{versionId} : post"
  faultTime: 
    type: 
    example: '2018-11-29T22:01:51.862-05:00'
  innerFault:
    properties:     
      faultCode:
        properties: 
          parentErrorType:
            properties: 
              parentErrorType:
                properties: 
                  parentErrorType: 
                    type: string?
                    example: null
                  namespace: 
                    type: string
                    example: MULE
                  identifier: 
                    type: string
                    example: ANY
              namespace: 
                type: string
                example: APIKIT
              identifier: 
                type: string
                example: ANY
          namespace: 
            type: string
            example: APIKIT
          identifier: 
            type: string
            example: METHOD_NOT_ALLOWED
      faultMessage: 
        type: string
        example: "/pageCommand/pageVersion/{pageId}/{versionId} : post"
      faultDetail: 
        type: string
        example: "/pageCommand/pageVersion/{pageId}/{versionId} : post"
