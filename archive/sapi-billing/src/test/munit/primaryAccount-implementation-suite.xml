				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[output text/xml --- readUrl('classpath://primaryAccountimplementation200\mock_payload.dwl')]" mediaType="text/xml" encoding="UTF-8" />
					<munit-tools:variables >
						<munit-tools:variable key="samlResponse" value="#[output text/xml --- readUrl('classpath://primaryAccountimplementation200\mock_var_billingSAMLToken.dwl')]" mediaType="text/xml" encoding="UTF-8" />
						<munit-tools:variable key="billingAccountNumber" value="#[output application/java --- readUrl('classpath://primaryAccountimplementation200\mock_var_billingAccountNumber.dwl')]" mediaType="application/json" encoding="UTF-8" />
					</munit-tools:variables>
				</munit-tools:then-return>
