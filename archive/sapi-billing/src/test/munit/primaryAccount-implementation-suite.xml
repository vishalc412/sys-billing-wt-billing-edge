		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="094a03da-c21a-4b2d-893b-99bc921da8cd" is="#[MunitTools::notNullValue()]" expression="#[import * from dw::test::Asserts ---&#10;        vars.attributes must [ $.statusCode must equalTo(204)]]"/>
		</munit:validation>
