			<munit:set-event doc:name="Set Input" doc:id="5706c909-1b8a-41d1-906c-01de833e31b7" >
				<munit:attributes value="#[readUrl('classpath://primaryAccountimplementation200\attributeConfig.dwl')]" />
			</munit:set-event>
		</munit:behavior>
		<munit:execution >
			<flow-ref doc:name="Flow-ref to primaryAccount-implementation" doc:id="5c27a98e-307e-4b4a-b156-c73bcf6f4a25" name="primaryAccount-implementation"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert doc:name="Assert payload" doc:id="3df86462-d8f8-4e04-8344-8701038a9414" message="The payload does not match">
				<munit-tools:that ><![CDATA[#[%dw 2.0
import primaryAccountimplementation200::expected_response_payload
---
expected_response_payload::main({payload: payload, attributes: attributes, vars: vars})]]]></munit-tools:that>
			</munit-tools:assert>
		</munit:validation>
	</munit:test>
	<munit:test name="primaryAccount-implementation-204" doc:id="63f8c3fc-262d-43b2-9e88-89d22d263612" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock when" doc:id="2d4eabe9-5602-42c8-83d0-ffaa5ef2b7af" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="BillingService" attributeName="doc:name" />
					<munit-tools:with-attribute whereValue="a3fa4438-8b6c-44ca-bb56-e50963e1324d" attributeName="doc:id" />
